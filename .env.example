# LLM Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace & Weights/Biases
HF_TOKEN=your_huggingface_token_here
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=llm-grading-challenge

# Environment & Runtime Configuration
PYTHONPATH=.
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
RANDOM_SEED=42
VAL_RATIO=0.2

# ---------------------------------------------------------------------------
# Per-person Colab / git settings (DO NOT commit real .env — copy from this file)
# Each teammate can use a different REPO_BRANCH while iterating.
# ---------------------------------------------------------------------------
REPO_URL=https://github.com/tiendinhquang2104/llm-final-project.git
REPO_BRANCH=task-1

# Google Drive paths (Colab). Adjust to your own Drive layout.
DRIVE_DATA_DIR=/content/drive/MyDrive/LLM/Final Project/data
REPO_DIR_ON_DRIVE=/content/drive/MyDrive/LLM/Final Project/llm-final-project
# Optional: path to a private .env on Drive (loaded first in Colab)
# DRIVE_ENV_FILE=/content/drive/MyDrive/LLM/Final Project/.env

# Local Model & Data Paths
BASE_MODEL_DIR=./models/base
CHECKPOINT_DIR=./checkpoints
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_SPLITS_DIR=./data/splits
OUTPUT_DIR=./outputs
